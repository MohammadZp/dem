        <mxCell id="c4_title" value="&lt;b&gt;C4: Detailed Execution Sequence — Two-Phase Reservation &amp; Booking Flow&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="650" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Reserve Request&lt;/b&gt;&lt;br/&gt;Client sends POST /bookings/reserve with ticket_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2980B9;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Set Redis Distributed Lock&lt;/b&gt;&lt;br/&gt;Booking Service executes: &lt;code&gt;SET ticket_lock:123 user_456 NX EX 600&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2980B9;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Return Reservation Success&lt;/b&gt;&lt;br/&gt;Returns 200 OK with 10-minute countdown timer to Client." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Payment Checkout&lt;/b&gt;&lt;br/&gt;Client submits credit card info directly to Stripe API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Confirm &amp; Webhook Callback&lt;/b&gt;&lt;br/&gt;Stripe calls webhook &lt;code&gt;POST /bookings/confirm&lt;/code&gt; with payment token." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. PostgreSQL Transaction Commit&lt;/b&gt;&lt;br/&gt;&lt;code&gt;BEGIN; UPDATE tickets SET status='booked', user_id=456 WHERE id=123; COMMIT;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E6F1;strokeColor=#2980B9;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Release Redis Lock &amp; SSE Broadcast&lt;/b&gt;&lt;br/&gt;Delete Redis key &lt;code&gt;ticket_lock:123&lt;/code&gt; and broadcast 'booked' state via SSE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="400" width="450" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s8_timeout" value="&lt;b&gt;AUTOMATIC TIMEOUT FALLBACK (If Payment Not Completed within 10 Minutes):&lt;/b&gt;&lt;br/&gt;1. Redis automatically drops key &lt;code&gt;ticket_lock:123&lt;/code&gt; after 600 seconds.&lt;br/&gt;2. PostgreSQL status remains &lt;code&gt;available&lt;/code&gt; (unmodified).&lt;br/&gt;3. Next client querying event tickets instantly sees seat 123 as available." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#CB4335;fontSize=12;align=left;" vertex="1" parent="1">
