        <mxCell id="c1_user" value="&lt;b&gt;Cloud User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Uploads, syncs, shares, and streams video/files across Mac, Windows, iOS, Web." style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#084B8A;fontColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="280" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c1_system" value="&lt;b&gt;Dropbox &amp; Video Sharing System&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;Provides block-level file chunking, metadata synchronization, deduplication, resumable uploads, and automated video transcoding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0b4884;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="230" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c1_s3" value="&lt;b&gt;Cloud Object Storage (AWS S3)&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;Stores raw block chunks (5MB) and processed video transcoded bitrates (HLS/DASH)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1_cdn" value="&lt;b&gt;Global Content Delivery Network (CDN)&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;Caches block chunks and HLS video segments at edge locations for low-latency playback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="310" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c1_auth" value="&lt;b&gt;Auth Gateway / OAuth 2.0 Provider&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;Handles user identity, JWT issuing, and single sign-on authentication." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="470" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_c1_context_1" value="Uploads files/videos, syncs local folders via HTTPS/gRPC" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c1_user" target="c1_system">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_c1_context_2" value="Direct block chunk reads/writes &amp; pre-signed URLs" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c1_system" target="c1_s3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_c1_context_3" value="Distributes transcoded video segments and static file chunks" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c1_system" target="c1_cdn">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_c1_context_4" value="Validates JWT session tokens" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c1_system" target="c1_auth">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
